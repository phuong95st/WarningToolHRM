<configuration scan="true" scanPeriod="30 seconds">
    <property name="LOG_DIR" value="logs" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Daily Rolling File Appender with 30-day retention -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/hrm-tool.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover: hrm-tool-2026-10-13.log -->
            <fileNamePattern>${LOG_DIR}/hrm-tool-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep at most 30 days (1 month) of logs -->
            <maxHistory>30</maxHistory>
            <!-- Clean history on start -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Dedicated Daily Attendance History Appender -->
    <appender name="ATTENDANCE_HISTORY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/attendance-summary.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/attendance-summary-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="ATTENDANCE_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="ATTENDANCE_HISTORY" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
